# Copy this file to .env and provide credentials for your own environment.
# Never commit the resulting .env file.

NODE_ENV=development
PORT=8090
PROJECT_NAME=Demo Project
DATA_DIR=data
DATABASE_URL=file:../../data/data.db

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=AI 交付助理
FEISHU_SEND_RETRY_COUNT=1

# Optional dedicated AI news bot. By default the existing bot is reused.
AI_NEWS_ENABLED=true
AI_NEWS_SOURCE_URL=https://aihot.virxact.com
AI_NEWS_DEFAULT_LIMIT=15
AI_NEWS_REQUEST_TIMEOUT_MS=10000
# FEISHU_AI_NEWS_APP_ID=
# FEISHU_AI_NEWS_APP_SECRET=
# FEISHU_AI_NEWS_BOT_NAME=AI 热点新闻助手

# TAPD
TAPD_WORKSPACE_ID=0
TAPD_API_TOKEN=
TAPD_WORKITEM_TYPE_ID=
TAPD_API_BASE=https://api.tapd.cn

# OpenAI-compatible model provider
AI_PROVIDER=openai
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Optional HTTP proxy for model calls
LLM_USE_PROXY=false
HTTP_PROXY_URL=
