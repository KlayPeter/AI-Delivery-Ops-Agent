# Frontend image: Vite static build served by unprivileged Nginx.
FROM node:22-bookworm-slim AS builder

WORKDIR /app

RUN npm install -g pnpm@10

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/index.html frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/vite.config.ts frontend/eslint.config.js ./
COPY frontend/src ./src
COPY frontend/public ./public

ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}
RUN pnpm build

FROM nginxinc/nginx-unprivileged:alpine

ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
ENV BACKEND_UPSTREAM=http://delivery-ops-backend:8090

COPY docker/web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080
