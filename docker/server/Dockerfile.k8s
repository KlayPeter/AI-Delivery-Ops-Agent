# Backend image for local Docker and K8s deployments.
FROM oven/bun:1.3.14 AS builder

WORKDIR /app/backend

# Install dependencies first so Docker can reuse the layer when app code changes.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY prisma ./prisma
COPY src ./src
COPY tsconfig.json prisma.config.ts ./

# Generate Prisma Client for the Linux runtime image and fail fast on TS errors.
RUN bunx prisma generate
RUN bun run typecheck

FROM oven/bun:1.3.14-slim

WORKDIR /app/backend

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/backend /app/backend

ENV NODE_ENV=production
ENV PORT=8090
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

RUN mkdir -p /app/data \
    && chown -R bun:bun /app/backend /app/data

USER bun

EXPOSE 8090

# Prisma Client is already generated in the builder stage; skip runtime generate
# so the unprivileged bun user does not need to write under node_modules.
CMD ["sh", "-c", "bun run db:deploy-safe && bun run start"]
